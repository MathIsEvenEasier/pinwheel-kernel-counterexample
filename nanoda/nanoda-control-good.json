{
  "use_stdin": false,
  "permitted_axioms": [
    "propext",
    "Quot.sound"
  ],
  "unpermitted_axiom_hard_error": true,
  "unsafe_permit_all_axioms": false,
  "num_threads": 1,
  "nat_extension": true,
  "string_extension": true,
  "print_success_message": true,
  "print_axioms": true,
  "unknown_pp_declar_hard_error": true,
  "pp_to_stdout": true,
  "pp_options": {
    "proofs": false,
    "notation": false,
    "width": 100
  },
  "export_file_path": "nanoda-control-export.ndjson",
  "pp_declars": [
    "NanodaControl.probe"
  ]
}
